# Dependencies (patterns here are root-anchored, so ** is needed for nested dirs)
node_modules/
**/node_modules

# Abandoned Next.js/Prisma prototype — not part of the build
app/

# Build output (will be created in Docker)
dist/

# Data files
data/
*.db

# Git
.git/
.gitignore

# Environment files (** so nested secrets never reach the build context)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Editor
.idea/
.vscode/

# Misc
*.md
LICENSE
.dockerignore

# OS files
.DS_Store
Thumbs.db

